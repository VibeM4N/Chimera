# Backend Environment Variables

# Database
MONGODB_URI=mongodb://localhost:27017/chimera
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/chimera

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# External APIs
URL_SCANNER_API=https://url-backend-yn04.onrender.com/scan
EMAIL_SCANNER_API=https://adelia-commonsense-soaked.ngrok-free.dev/api/email/scan

# CORS
CORS_ORIGIN=http://localhost:3000
